{
  "name": "@craftskillz/git-integration",
  "version": "0.1.0",
  "private": true,
  "description": "Back up your Tessello space to a git repository: set up tessello sync and see how the backup is going.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/craftskillz/tessello-git-integration.git"
  },
  "homepage": "https://github.com/craftskillz/tessello-git-integration#readme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "test": "node --test \"test/*.test.ts\"",
    "test:browser": "npm run build && node --test --test-concurrency=1 \"e2e/*.test.ts\"",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@tessello/sdk": "0.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "playwright": "^1.65.0",
    "svelte": "^5.57.2",
    "tessello": "0.2.0",
    "typescript": "~5.9.3"
  }
}
